@startuml RemoteAccessModuleCurrent
skinparam classAttributeIconSize 0
hide empty methods
hide empty fields

package "xconv2.remote_access" {
  class RemoteLoggingConfiguration {
    scope_levels: dict[str,int]
  }

  class RemoteEntry {
    path: str
    name: str
    is_dir: bool
    size: int?
    is_link: bool
  }

  class RemoteFilesystemSpec {
    protocol: str
    storage_options: dict
    root_path: str
    display_name: str
    uri_scheme: str
    uri_authority: str
    proxy_jump: str?
  }

  class RemoteAccessSession {
    +list_entries(path)
    +read_fields(descriptor, datasets, reader)
    +close()
    +configure_logging(...)
    +logging_configuration()
  }

  class "Descriptor helpers" as DescriptorHelpers <<utility>>
  class "Entry helpers" as EntryHelpers <<utility>>
  class "Dataset normalization" as DatasetHelpers <<utility>>
  class "Filesystem builders" as FilesystemHelpers <<utility>>
}

package "xconv2" {
  class RemoteFileSystemFactory
  class cache_utils <<module>>
}

RemoteAccessSession --> RemoteLoggingConfiguration
RemoteAccessSession --> RemoteEntry : returns
DescriptorHelpers --> RemoteFilesystemSpec
EntryHelpers --> RemoteEntry
FilesystemHelpers --> RemoteFilesystemSpec
FilesystemHelpers ..> RemoteFileSystemFactory : create_filesystem(...)
FilesystemHelpers ..> cache_utils : prune_disk_cache()\nparse_disk_expiry_seconds()
DatasetHelpers ..> RemoteFilesystemSpec

note right of FilesystemHelpers
create_filesystem() applies disk cache pruning before
building protocol-specific filesystems.
end note

@enduml
